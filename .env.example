# Contact form email — Resend (https://resend.com)
# Copy to .env.local and fill in the values.

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# The inbox that should receive portfolio contact messages (your real email).
CONTACT_TO_EMAIL=

# Optional: verified sender address once you add/verify a domain in Resend.
# Default (test mode): onboarding@resend.dev
# RESEND_FROM_EMAIL=Contact <hello@yourdomain.com>

NEXT_PUBLIC_SITE_URL=https://vishal-kumar-choudhary-frontend-developer.vercel.app

# Labs authentication — Better Auth + MongoDB
# Stable Better Auth user ID for the single source-management owner.
# Keep this server-only; leave blank to disable owner tools.
LABS_OWNER_USER_ID=
# Required for authentication (keep every value server-side).
MONGODB_URI=
MONGODB_DB_NAME=
BETTER_AUTH_SECRET=
# Optional: Better Auth Infrastructure Dash API key (server-side only).
BETTER_AUTH_API_KEY=
BETTER_AUTH_URL=https://your-production-domain.example
# Comma-separated extra trusted origins (for approved preview deployments).
BETTER_AUTH_TRUSTED_ORIGINS=
# Trusted reverse-proxy header used for registration abuse limits.
# Vercel deployments normally use x-vercel-forwarded-for.
AUTH_TRUSTED_IP_HEADER=x-vercel-forwarded-for

# Labs authentication email — any authenticated SMTP service.
# Registration, verification resend and password reset remain disabled until
# the SMTP settings below are valid.
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_USER=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_SECURE=false
AUTH_EMAIL_FROM=

# Optional Google OAuth. The Google action is hidden until both values exist.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Terms and Privacy are first-party pages at /terms and /privacy.
# Canonical URLs derive from NEXT_PUBLIC_SITE_URL; versions are maintained
# server-side in src/app/lib/legal/policies.js. No separate env values needed.
