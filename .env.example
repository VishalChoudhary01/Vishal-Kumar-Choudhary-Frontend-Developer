# Contact form email — Resend (https://resend.com)
# Copy to .env.local and fill in the values.

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# The inbox that should receive portfolio contact messages (your real email).
CONTACT_TO_EMAIL=

# Optional: verified sender address once you add/verify a domain in Resend.
# Default (test mode): onboarding@resend.dev
# RESEND_FROM_EMAIL=Contact <hello@yourdomain.com>

NEXT_PUBLIC_SITE_URL=https://vishal-kumar-choudhary-frontend-developer.vercel.app

# Labs authentication — Better Auth + MongoDB
# Stable Better Auth user ID for the single source-management owner.
# Keep this server-only; leave blank to disable owner tools.
LABS_OWNER_USER_ID=
# Required for authentication (keep every value server-side).
MONGODB_URI=
MONGODB_DB_NAME=
BETTER_AUTH_SECRET=
# Optional: Better Auth Infrastructure Dash API key (server-side only).
BETTER_AUTH_API_KEY=
BETTER_AUTH_URL=https://your-production-domain.example
# Comma-separated extra trusted origins (for approved preview deployments).
BETTER_AUTH_TRUSTED_ORIGINS=
# Trusted reverse-proxy header used for registration abuse limits.
# Vercel deployments normally use x-vercel-forwarded-for.
AUTH_TRUSTED_IP_HEADER=x-vercel-forwarded-for

# Labs authentication email — any authenticated SMTP service.
# Email/password registration, verification resend and password reset remain
# disabled until the SMTP settings below are valid. OAuth signup uses provider
# verification and does not depend on SMTP.
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_USER=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_SECURE=false
AUTH_EMAIL_FROM=

# Labs experiment media — Cloudinary signed uploads (server-only).
# Configure separate signed image and video upload presets in Cloudinary.
# Never expose CLOUDINARY_API_SECRET through a NEXT_PUBLIC_ variable.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_LABS_IMAGE_UPLOAD_PRESET=
CLOUDINARY_LABS_VIDEO_UPLOAD_PRESET=
# Required integer byte ceiling; set only after reviewing the account quota.
LABS_MEDIA_MAX_UPLOAD_BYTES=

# Optional Google OAuth. The action is hidden until both values exist.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional GitHub OAuth. The action is hidden until both values exist.
# The OAuth app needs the user:email scope for verified primary email lookup.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Privacy Policy is a public informational page at /privacy.
# It is not required for registration and has no signup consent checkbox.


# First-party Portfolio Analytics (disabled until the owner enables it).
# Keep both values server-side. HMAC secret must contain at least 32 bytes.
PORTFOLIO_ANALYTICS_ENABLED=false
PORTFOLIO_ANALYTICS_HMAC_SECRET=
# Optional for local development only; Vercel preview deployments remain excluded.
PORTFOLIO_ANALYTICS_ALLOW_LOCAL=false
