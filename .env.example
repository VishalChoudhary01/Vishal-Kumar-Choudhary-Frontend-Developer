# Contact form email — Resend (https://resend.com)
# Copy to .env.local and fill in the values.

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# The inbox that should receive portfolio contact messages (your real email).
CONTACT_TO_EMAIL=

# Optional: verified sender address once you add/verify a domain in Resend.
# Default (test mode): onboarding@resend.dev
# RESEND_FROM_EMAIL=Contact <hello@yourdomain.com>

NEXT_PUBLIC_SITE_URL=https://vishal-kumar-choudhary-frontend-developer.vercel.app
