# See https://help.github.com/articles/ignoring-files/ for more information.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
.next-*/
out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------
# Local-only documentation
# Internal notes, audits, specs and lab docs stay on disk but are
# never published. The main README remains tracked.
# ---------------------------------------------------------------
*.md
*.markdown
!README.md
!README.markdown

# Local-only development documentation folders (exact folder names)
/performance doc/
/implemention Doc/
/dyanmic portfolio lab/

# Local-only agent / tooling state
/.freebuff/
/.claude/
/.agents/

# ---------------------------------------------------------------
# Local debugging, probing and profiling artifacts
# (kept on disk for local work; not published)
# ---------------------------------------------------------------
*.zip
/verify-*.cjs
/src/verify-button.cjs
/probe-hover*.cjs
/debug-arrow.cjs
/debug-arrow.css
verify-out.txt
hydration-log.txt
/.baseline-*.json
scripts/error-*.cjs
scripts/hydration-check.cjs
scripts/nav-scroll-check.cjs
scripts/reversal-hover-check.cjs
scripts/showcase-lightbox-check.cjs
scripts/showcase-scale-check.cjs
scripts/baseline-measure.cjs
scripts/orphan-scan.cjs
scripts/section-scan.cjs
scripts/format-cleanup.cjs
scripts/optimize-favicons.cjs
