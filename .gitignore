# See https://help.github.com/articles/ignoring-files/ for more information.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
.next-*/
out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------
# Local-only documentation
# Keep documentation exclusions limited to the known local-only paths.
# ---------------------------------------------------------------
/implementation Doc/
/performance doc/
/implemention Doc/
/PERFORMANCE-OPTIMIZATION-REPORT.md
/dyanmic portfolio lab/

# Local-only agent / tooling state
/.freebuff/
/.claude/
/.agents/

